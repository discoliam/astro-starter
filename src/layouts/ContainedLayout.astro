---
import Layout from "./Layout.astro";

// Pass all frontmatter through so Layout/Seo see title, excerpt, image, noindex, etc.
const { frontmatter, headings } = Astro.props;
---

<Layout frontmatter={frontmatter} headings={headings}>
  <div class="Container ContainedLayout">
    <slot />
  </div>
</Layout>
