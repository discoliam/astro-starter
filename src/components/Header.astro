---
import { site } from "../data/site";
import Menu from "./Menu.astro";

import { getTopMenu } from "../utils/navigation";
import NavItem from "./NavItem.astro";
const menuTree = await getTopMenu();
---

<header class="Header">
  <div class="Header__Container Container">
    <a class="Logo" href="/">
      {site.info.siteName}
    </a>

    <nav class="DesktopNav" aria-label="Main">
      <ul class="Menu">
        {menuTree.map((item) => (
          <NavItem item={item} />
        ))}
      </ul>
    </nav>

    <button
      class="MenuToggle"
      aria-label="Open Menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      id="menu-open"
    >
      <span class="Hamburger"></span>
    </button>

    <div class="MobileMenu__Wrapper" id="mobile-menu">
      <button
        class="MobileMenu__Close"
        aria-label="Close Menu"
        id="MobileMenu__Close"
      >
        &times;
      </button>
      <nav class="MobileMenu__Nav" aria-label="Mobile">
        <Menu />
      </nav>
    </div>

    <div class="PageOverlay" id="PageOverlay"></div>
  </div>
</header>

<style>
  /* --- Layout & Container --- */
  .Header {
    background: var(--palette-dark);
    color: var(--palette-light);
    position: sticky;
    top: 0;
    z-index: 100;
    & a {
      color: var(--palette-light);
      text-decoration: none;
      &:hover {
        color: var(--palette-hover);
      }
    }
  }
  .Header__Container {
    padding: 0 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--header-height);
  }

  a.Logo {
    display: block;
    margin: 0;
    color: var(--palette-light);
    font-family: var(--Secondary-Font);
    font-size: var(--Type-Paragraph-Default);
    font-style: normal;
    font-weight: 400;
    line-height: 150%;
    & svg {
      width: 110px;
      height: 34px;
      color: var(--palette-action);
      margin-right: var(--Spacing-x3);
    }
    &:hover {
      color: var(--palette-hover);
    }
  }

  /* --- Desktop Navigation (Horizontal + Hover) --- */
  .DesktopNav {
    display: none;
  }

  @media (--mq-tablet-and-up) {
    .DesktopNav {
      display: block;
      height: 100%;
    }
    .MenuToggle {
      display: none;
    }

    /* Top-level nav list */
    .DesktopNav :global(> ul) {
      list-style: none;
      display: flex;
      gap: var(--Spacing-x12);
      margin: 0;
      padding: 0;
    }

    .DesktopNav :global(li) {
      position: relative;
    }

    .DesktopNav :global(.Menu) {
      height: 100%;
    }

    .DesktopNav :global(> ul > .NavItem--has-children) {
      position: static;
    }

    /* ── Mega Panel ── */
    .DesktopNav :global(> ul > .NavItem--has-children > ul) {
      list-style: none;
      position: fixed;
      top: var(--header-height);
      outline: solid 1px var(--palette-dark);
      left: 0;
      right: 0;
      z-index: 99;
      display: flex;
      justify-content: flex-start;
      align-items: center;
      gap: var(--Spacing-x8);
      flex-wrap: wrap;
      background-color: var(--palette-dark);
      color: var(--palette-dark);
      transition: all var(--global-transition);
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      padding: var(--Spacing-Standard-Gutter) var(--page-calculated-padding)
        var(--Spacing-Double-Gutter) var(--page-calculated-padding);
      &::after {
        content: "";
        display: block;
        width: calc(
          100% - var(--page-calculated-padding) - var(--page-calculated-padding)
        );
        height: 1px;
        opacity: 0.2;
        background-color: var(--palette-mid);
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
      }
    }

    .DesktopNav :global(> ul > .NavItem--has-children:hover > ul),
    .DesktopNav :global(> ul > .NavItem--has-children:focus-within > ul) {
      pointer-events: auto;
      opacity: 1;
      visibility: visible;
    }

    /* Two-tier panel (e.g. Identity → Visual / Verbal Identity) */
    .DesktopNav :global(.NavItem__Dropdown--grouped) {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--Spacing-x12);
    }

    .DesktopNav :global(.NavItem__Group) {
      display: flex;
      flex-direction: column;
      gap: var(--Spacing-x4);
      width: 100%;
    }

    .DesktopNav :global(.NavItem__GroupLinks) {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: var(--Spacing-x8);
      margin: 0;
      padding: 0;
    }

    .DesktopNav :global(> ul > .NavItem--has-children > ul > li > a) {
      font-size: var(--Type-Paragraph-Default);
      font-weight: 500;
    }
  }

  /* --- Mobile Slide-in Menu --- */
  .MobileMenu__Wrapper {
    position: fixed;
    top: 0;
    right: -300px; /* Hidden by default */
    width: 300px;
    height: 100vh;
    background: var(--palette-dark);
    color: var(--palette-light);
    z-index: 200;
    transition: transform var(--global-transition);
    padding: 4rem 2rem;
    box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
  }

  /* When JS adds .is-open class */
  .MobileMenu__Wrapper.is-open {
    transform: translateX(-300px);
  }

  .PageOverlay {
    position: fixed;
    inset: 0;
    opacity: 0;
    background: var(--palette-dark);
    z-index: 150;
    transition: all var(--global-transition);
    display: block;
    pointer-events: none;
  }

  .PageOverlay.is-open {
    pointer-events: default;
    opacity: 0.8;
  }

  .MobileMenu__Nav :global(ul) {
    list-style: none;
    padding: 0;
  }

  .MobileMenu__Nav :global(li) {
    margin: var(--Spacing-x6) 0;
  }

  /* Child lists collapsed by default on mobile */
  .MobileMenu__Nav :global(ul ul) {
    display: none;
    padding-left: var(--Spacing-x3);
    border-top: solid 1px var(--palette-mid);
    border-bottom: solid 1px var(--palette-mid);
  }

  .MobileMenu__Nav :global(ul ul li a.NavItem__Link) {
    font-size: var(--Type-Paragraph-S);
  }

  .MobileMenu__Nav :global(a.NavItem__Link svg) {
    display: none !important;
  }

  .MobileMenu__Nav :global(.NavItem--has-children.is-open > ul) {
    display: block;
  }

  /* Grouped links sit inside the open dropdown, so don't collapse them */
  .MobileMenu__Nav :global(.NavItem__GroupLinks) {
    display: block;
    padding-left: 0;
    border: 0;
  }

  .MobileMenu__Nav :global(.NavItem__Group) {
    margin-top: var(--Spacing-x6);
  }

  /* Group heading (desktop panel + mobile menu) */
  .Header :global(.NavItem__GroupTitle) {
    display: block;
    color: var(--palette-light);
    font-family: var(--Secondary-Font);
    font-size: var(--Type-Paragraph-L);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }

  /* Row layout for link + toggle button */
  .MobileMenu__Nav :global(.NavItem__ChildWrap) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--Spacing-x3);
  }

  .MobileMenu__Nav :global(.NavItem__ChildWrap a) {
    flex: 1;
  }

  .MobileMenu__Nav :global(.nav-toggle) {
    background: none;
    border: none;
    cursor: pointer;
    width: 40px;
    height: 40px;
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    & svg {
      width: 12px;
      height: 12px;
      transition: transform var(--global-transition);
      pointer-events: none;
    }
  }

  .MobileMenu__Nav :global(.nav-toggle svg) {
    width: 12px;
    height: 12px;
    transition: transform var(--global-transition);
    pointer-events: none;
  }

  .MobileMenu__Nav
    :global(.NavItem--has-children.is-open > .NavItem__ChildWrap svg) {
    transform: rotate(180deg);
  }

  /* Hide toggle button in desktop nav */
  .DesktopNav :global(.nav-toggle) {
    display: none;
  }

  /* --- Hamburger Button UI --- */
  .MenuToggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
  }
  .Hamburger {
    display: block;
    width: 25px;
    height: 2px;
    background: var(--palette-light);
    position: relative;
    transition: background-color var(--global-transition);
    &::before,
    &::after {
      content: "";
      width: 25px;
      height: 2px;
      background: var(--palette-light);
      position: absolute;
      left: 0;
      transition: background-color var(--global-transition);
    }

    &:hover {
      background-color: var(--palette-hover);
      &::before,
      &::after {
        background-color: var(--palette-hover);
      }
    }
  }

  .Hamburger::before {
    top: -8px;
  }
  .Hamburger::after {
    bottom: -8px;
  }

  .MobileMenu__Close {
    position: absolute;
    top: var(--Spacing-x3);
    right: var(--Spacing-x3);
    font-size: 2rem;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--palette-action);
  }
</style>

<script>
  const initMenu = () => {
    const openBtn = document.getElementById("menu-open");
    const closeBtn = document.getElementById("MobileMenu__Close");
    const mobileMenu = document.getElementById("mobile-menu");
    const overlay = document.getElementById("PageOverlay");
    const body = document.body;

    function resetAccordion() {
      document
        .querySelectorAll(".MobileMenu__Nav .NavItem--has-children.is-open")
        .forEach((li) => {
          li.classList.remove("is-open");
          li.querySelector(".nav-toggle")?.setAttribute(
            "aria-expanded",
            "false",
          );
        });
    }

    function toggleMenu(isOpen) {
      mobileMenu.classList.toggle("is-open", isOpen);
      overlay.classList.toggle("is-open", isOpen);
      body.style.overflow = isOpen ? "hidden" : "";
      openBtn.setAttribute("aria-expanded", isOpen.toString());

      if (!isOpen) resetAccordion();
    }

    openBtn.addEventListener("click", () => toggleMenu(true));

    [closeBtn, overlay].forEach((el) => {
      el.addEventListener("click", () => toggleMenu(false));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") toggleMenu(false);
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) toggleMenu(false);
    });

    // Accordion: one section open at a time per level
    document
      .querySelectorAll(".MobileMenu__Nav .nav-toggle")
      .forEach((button) => {
        button.addEventListener("click", () => {
          const li = button.closest(".NavItem--has-children");
          const isOpen = li.classList.contains("is-open");
          const parentUl = li.parentElement;

          // Close all open siblings at this level
          parentUl
            .querySelectorAll(":scope > .NavItem--has-children.is-open")
            .forEach((sibling) => {
              sibling.classList.remove("is-open");
              sibling
                .querySelector(":scope > .NavItem__ChildWrap > .nav-toggle")
                ?.setAttribute("aria-expanded", "false");
            });

          // Open the clicked item if it was closed
          if (!isOpen) {
            li.classList.add("is-open");
            button.setAttribute("aria-expanded", "true");
          }
        });
      });
  };

  // Runs on initial load
  initMenu();

  // Runs after every View Transition / Page Swap
  document.addEventListener("astro:page-load", initMenu);
</script>
